<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="com.cl.dao.QicherukuDao">

	<!-- 可根据自己的需求，是否要使用 -->
    <resultMap type="com.cl.entity.QicherukuEntity" id="qicherukuMap">
        <result property="chepaihao" column="chepaihao"/>
        <result property="qichemingcheng" column="qichemingcheng"/>
        <result property="qichetupian" column="qichetupian"/>
        <result property="cheliangleixing" column="cheliangleixing"/>
        <result property="qichepinpai" column="qichepinpai"/>
        <result property="cheshenyanse" column="cheshenyanse"/>
        <result property="xiangqingdizhi" column="xiangqingdizhi"/>
        <result property="qichexiangqing" column="qichexiangqing"/>
    </resultMap>

    <select id="selectListView"
		resultType="com.cl.entity.view.QicherukuView" >

		SELECT  qicheruku.* FROM qicheruku  qicheruku 	        
        <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	
	<select id="selectView"
		resultType="com.cl.entity.view.QicherukuView" >
		SELECT * FROM qicheruku  qicheruku <where> 1=1 ${ew.sqlSegment}</where>
	</select>
	

</mapper>
